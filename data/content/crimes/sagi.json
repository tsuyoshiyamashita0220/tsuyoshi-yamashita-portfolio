  "summary": {
    "text": "人を欺いて財物を交付させたときに成立する罪です。",
    "lawRefs": [
      {
        "lawId": "140AC0000000045",
        "article": "246",
        "paragraph": "1"
      }
    ]
  },
  "elements": [
    {
      "text": "手段は「人を欺いて」です。",
      "lawRefs": [
        {
          "lawId": "140AC0000000045",
          "article": "246",
          "paragraph": "1"
        }
      ]
    },
    {
      "text": "人を欺いて、財物を「交付させた」ことが必要です。",
      "lawRefs": [
        {
          "lawId": "140AC0000000045",
          "article": "246",
          "paragraph": "1"
        }
      ]
    },
    {
      "text": "同じ方法で、財物ではなく財産上不法の利益を得たり、他人に得させたりした場合も、同じように処罰されます。",
      "lawRefs": [
        {
          "lawId": "140AC0000000045",
          "article": "246",
          "paragraph": "2"
        }
      ]
    },
    {
      "text": "未遂も罰せられます。",
      "lawRefs": [
        {
          "lawId": "140AC0000000045",
          "article": "250"
        }
      ]
    }
  ],
